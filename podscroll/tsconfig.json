{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["vite/client"],
    "allowSyntheticDefaultImports": true,
    "paths": { "@shared/*": ["../shared/*"] }
  },
  "include": ["./*.tsx", "../client/src/components/family-hub/earshot/EarshotPlayer.tsx", "../shared/earshot.ts"]
}
