{
  "manifest_version": 3,
  "name": "Arise Read Aloud",
  "version": "1.0.0",
  "description": "Reads what is on the screen out loud in a natural AI voice, with the words highlighted as they are read. Made for students who need text-to-speech.",
  "permissions": ["activeTab", "scripting", "storage", "offscreen", "webNavigation"],
  "host_permissions": [
    "https://arisetodo.com/*",
    "https://*.peardeck.com/*",
    "https://*.joinpd.com/*",
    "https://docs.google.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Arise Read Aloud", "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "toggle-read": { "suggested_key": { "default": "Alt+Shift+R" }, "description": "Read the screen aloud / pause / resume" }
  },
  "content_scripts": [
    {
      "matches": ["https://*.peardeck.com/*", "https://*.joinpd.com/*", "https://docs.google.com/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
