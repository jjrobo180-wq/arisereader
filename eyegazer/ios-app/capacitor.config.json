{
  "appId": "com.arisereader.eyegazer",
  "appName": "Arise AAC",
  "webDir": "www",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#FFFFFF",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "native"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "StatusBar": {
      "style": "LIGHT"
    }
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#ffffff"
  }
}
