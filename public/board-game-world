<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>A.R.I.S.E. Board Quest</title><style>*{box-sizing:border-box}body{margin:0;font-family:system-ui;background:linear-gradient(#075985,#0f766e,#166534);color:#fff;min-height:100vh}.top{position:sticky;top:0;z-index:5;display:flex;justify-content:space-between;padding:10px;background:#020617dd}.btn{border:0;border-radius:14px;padding:12px 16px;font-weight:900}.back{background:#111827;color:white}.scores{display:flex;gap:8px}.blue{background:#1d4ed8}.gold{background:#facc15;color:#111827}.setup{min-height:100vh;display:grid;place-items:center;background:linear-gradient(#082f49,#312e81,#4c1d95);text-align:center;padding:20px}.card{max-width:760px;width:100%}.levels{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.level{background:#ffffff18;color:white;border:2px solid #ffffff33;border-radius:18px;padding:20px;font-size:20px;font-weight:900}.level.sel{background:#06b6d4;border-color:white}.start{margin-top:25px;background:#fde047;font-size:22px}.boardWrap{padding:25px 3vw 240px}.board{max-width:850px;margin:auto;background:#064e3b;border:10px solid #78350f;border-radius:30px;padding:10px;box-shadow:0 25px 60px #0008;transform:perspective(900px) rotateX(5deg)}.grid{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}.space{aspect-ratio:1;min-height:48px;border:1px solid #ffffff55;border-radius:10px;position:relative;padding:4px;font-weight:900}.points{background:#22c55e}.safe{background:#64748b}.steal{background:#ef4444}.shield{background:#3b82f6}.power{background:#a855f7}.rps{background:#f97316}.bonus{background:#facc15;color:#111827}.pieces{position:absolute;inset:0;display:flex;flex-wrap:wrap;align-items:center;justify-content:center}.piece{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;border:2px solid white;font-size:18px}.panel{position:fixed;bottom:10px;left:50%;transform:translateX(-50%);z-index:10;width:min(94vw,650px);background:#020617f2;border:1px solid #ffffff33;border-radius:25px;padding:14px;text-align:center;box-shadow:0 15px 40px #0008}.answers{display:grid;grid-template-columns:1fr 1fr;gap:8px}.answer{background:#ffffff18;color:white}.action{background:#22d3ee;color:#083344}.msg{font-weight:800;margin:8px}.dice{font-size:38px}@media(max-width:600px){.levels{grid-template-columns:1fr 1fr}.space{min-height:42px}.boardWrap{padding-left:6px;padding-right:6px}.board{border-width:6px}.piece{width:25px;height:25px;font-size:14px}.scores{font-size:12px}}</style></head><body><div id="app"></div><script>
const BANK={"K-2":[["What is 4 + 3?",["6","7","8","9"],1],["Which word rhymes with cat?",["dog","hat","sun","red"],1],["What is 10 - 2?",["6","7","8","9"],2]],"3-5":[["What is 8 × 6?",["42","46","48","54"],2],["Which is a synonym for happy?",["Glad","Angry","Tiny","Slow"],0],["What is 3/4 of 20?",["10","12","15","18"],2]],"6-8":[["Solve: 3x + 5 = 20",["3","5","7","15"],1],["What is 25% of 80?",["10","20","25","40"],1],["Which word is an adjective?",["Run","Quickly","Bright","Under"],2]],"9-12":[["Solve x² - 9 = 0. Positive solution?",["1","3","6","9"],1],["What is the slope between (0,2) and (4,10)?",["1","2","4","8"],1],["Which is a metaphor?",["Cold as ice","Time is a thief","He ran quickly","The dog barked"],1]]};
const EVENTS=["points","safe","steal","shield","power","rps","bonus"], EM={points:"+50",safe:"Safe",steal:"Steal",shield:"🛡️",power:"⚡",rps:"RPS",bonus:"+100"};let level=null,started=false,turn=0,blue=0,gold=0,q=null,dice=null,busy=false,msg="Choose a learning level.",winner=null;const fresh=()=>[{name:"You",team:"blue",space:0,strikes:0,shield:0,power:0,out:false,e:"🧑🏽‍🚀"},{name:"Robin",team:"gold",space:0,strikes:0,shield:0,power:0,out:false,e:"🏹"},{name:"Alice",team:"blue",space:0,strikes:0,shield:0,power:0,out:false,e:"👧"},{name:"Arthur",team:"gold",space:0,strikes:0,shield:0,power:0,out:false,e:"🤴"},{name:"Sherlock",team:"blue",space:0,strikes:0,shield:0,power:0,out:false,e:"🕵️"},{name:"Hercules",team:"gold",space:0,strikes:0,shield:0,power:0,out:false,e:"💪"}];let ps=fresh();
function render(){const a=document.getElementById('app');if(!started){a.innerHTML=`<main class="setup"><div class="card"><button class="btn back" onclick="leave()">← Worlds</button><div style="font-size:70px">🎲</div><h1>A.R.I.S.E. BOARD QUEST</h1><p>Answer • Roll • Move • Battle • Win together</p><div class="levels">${Object.keys(BANK).map(l=>`<button class="level ${level===l?'sel':''}" onclick="pick('${l}')">${l}</button>`).join('')}</div><button class="btn start" ${!level?'disabled':''} onclick="start()">START GAME</button></div></main>`;return}let cells='';for(let v=0;v<28;v++){let row=Math.floor(v/7),col=v%7,i=row%2===0?v:row*7+(6-col),ev=EVENTS[i%EVENTS.length],here=ps.filter(p=>p.space===i&&!p.out);cells+=`<div class="space ${ev}"><small>${i+1} ${EM[ev]}</small><div class="pieces">${here.map(p=>`<span class="piece ${p.team}">${p.e}</span>`).join('')}</div></div>`}let cur=ps[turn];a.innerHTML=`<div class="top"><button class="btn back" onclick="leave()">← Worlds</button><div class="scores"><b class="btn blue">🔵 ${blue} · ${ps.filter(p=>p.team==='blue'&&!p.out).length} left</b><b class="btn gold">🟡 ${gold} · ${ps.filter(p=>p.team==='gold'&&!p.out).length} left</b></div></div><div class="boardWrap"><div class="board"><div class="grid">${cells}</div></div></div><div class="panel"><b>${cur.e} ${cur.name} · ${cur.team.toUpperCase()}</b><div>Strikes ${'❌'.repeat(cur.strikes)||'0'} · 🛡️ ${cur.shield} · ⚡ ${cur.power}</div><div class="msg">${msg}</div>${q?`<h3>${q[0]}</h3><div class="answers">${q[1].map((x,i)=>`<button class="btn answer" onclick="answer(${i})">${x}</button>`).join('')}</div>`:winner?`<div style="font-size:28px;font-weight:900">🏆 ${winner} WINS!</div><button class="btn start" onclick="start()">PLAY AGAIN</button>`:!busy?`<button class="btn action" onclick="ask()">🎲 GET QUESTION</button>`:''}${dice?`<div class="dice">🎲 ${dice}</div>`:''}</div>`}
function leave(){location.replace('/worlds')}function pick(l){level=l;render()}function start(){ps=fresh();turn=0;blue=gold=0;q=dice=winner=null;busy=false;msg="Your turn — answer to unlock the dice!";started=true;render()}function ask(){if(!level||busy||winner)return;let b=BANK[level];q=b[Math.floor(Math.random()*b.length)];msg="Get it right to roll!";render()}function next(){let n=(turn+1)%ps.length;for(let i=0;i<ps.length&&ps[n].out;i++)n=(n+1)%ps.length;turn=n;q=dice=null;busy=false;msg=ps[n].name+"'s turn";render();if(ps[n].name!=="You")setTimeout(botTurn,700)}function botTurn(){if(winner)return;busy=true;msg=ps[turn].name+" is thinking…";render();setTimeout(()=>rollMove(1+Math.floor(Math.random()*6)),650)}function answer(i){if(!q||busy)return;let correct=q[2];q=null;busy=true;if(i!==correct){let p=ps[turn];if(p.shield){p.shield--;msg="🛡️ Shield blocked the strike!"}else{p.strikes++;msg=`❌ Strike ${p.strikes} of 3`;if(p.strikes>=3){p.out=true;msg=`❌ ${p.name} is out!`}}render();return setTimeout(next,900)}rollMove(1+Math.floor(Math.random()*6))}function rollMove(raw){let p=ps[turn],roll=Math.min(8,raw+(p.power?2:0));p.power=0;dice=roll;msg=`🎲 ${p.name} rolled ${roll}!`;let step=0;render();let t=setInterval(()=>{step++;p.space=Math.min(27,p.space+1);render();if(step>=roll||p.space>=27){clearInterval(t);setTimeout(eventSpace,300)}},220)}function eventSpace(){let p=ps[turn],e=EVENTS[p.space%EVENTS.length];if(e==='points'){p.team==='blue'?blue+=50:gold+=50;msg='🎉 +50 team points!'}else if(e==='steal'){if(p.team==='blue'){blue+=30;gold=Math.max(0,gold-30)}else{gold+=30;blue=Math.max(0,blue-30)}msg='⚡ Stole 30 points!'}else if(e==='shield'){p.shield++;msg='🛡️ Strike shield!'}else if(e==='power'){p.power++;msg='⚡ +2 future roll!'}else if(e==='bonus'){p.team==='blue'?blue+=100:gold+=100;msg='⭐ Jackpot +100!'}else if(e==='rps'){let r=ps.find(x=>x.team!==p.team&&!x.out);if(r){if(Math.random()>.5){r.strikes++;if(r.strikes>=3)r.out=true;msg='✊ RPS win — opponent gets a strike!'}else{p.strikes++;if(p.strikes>=3)p.out=true;msg='✋ RPS loss — strike!'}}}else msg='😌 Safe space.';if(p.space>=27){winner=(p.team==='blue'?'BLUE':'GOLD')+' TEAM';busy=false;render()}else{render();setTimeout(next,900)}}render();
</script></body></html>