{
  "appId": "com.arisereader.notes",
  "appName": "Arise Notes",
  "webDir": "www",
  "backgroundColor": "#f5f4fb",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "backgroundColor": "#f5f4fb",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "native"
    },
    "StatusBar": {
      "style": "LIGHT"
    }
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#f5f4fb"
  }
}
