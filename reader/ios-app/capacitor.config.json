{
  "appId": "com.arisereader.reader",
  "appName": "A.R.I.S.E. Reader",
  "webDir": "www",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#FFFFFF",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "native"
    },
    "LocalNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "updateUrl": "https://arisetodo.com/api/ota/reader",
      "channelUrl": "https://arisetodo.com/api/ota/reader",
      "statsUrl": ""
    }
  },
  "ios": {
    "contentInset": "automatic"
  }
}
