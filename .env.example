# Required
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server only: needed to award manual points. Never use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Required only when seeding an empty database; choose a unique password.
ADMIN_SEED_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Email (Resend) — needed for password resets & teacher notifications
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=A.R.I.S.E Reader <onboarding@resend.dev>
ADMIN_NOTIFY_EMAIL=jjrobo180@gmail.com

# Your deployed URL
APP_URL=https://arisereader.com

# Set by hosting provider automatically
# PORT=5000
# NODE_ENV=production


# Natural AI Learning Buddy voice (server only)
# Required for human-sounding Eye Gazer Learning Buddy speech.
# Never expose this with a VITE_ prefix.
OPENAI_API_KEY=your-openai-api-key
