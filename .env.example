# Required
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server only: needed to award manual points. Never use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Required only when seeding an empty database; choose a unique password.
ADMIN_SEED_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Email (Resend) — needed for teacher sign-up codes, password resets & teacher notifications.
# New teachers confirm their school email with a code sent from EMAIL_FROM, so it must be an
# address on a domain verified in Resend (the resend.dev test address only delivers to you).
# To reach the inbox instead of junk, that domain needs all three DNS records: SPF and DKIM (Resend
# gives you these when you verify the domain) and DMARC (a TXT record named _dmarc, for example
# "v=DMARC1; p=none;"). Without DMARC, Outlook, Gmail and school mail systems often file it as junk.
# If a code can't be sent, that teacher waits for admin approval instead.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=A.R.I.S.E Reader <onboarding@resend.dev>
ADMIN_NOTIFY_EMAIL=jjrobo180@gmail.com

# Your deployed URL
APP_URL=https://arisereader.com

# Set by hosting provider automatically
# PORT=5000
# NODE_ENV=production


# Natural AI Learning Buddy voice (server only)
# Required for human-sounding Eye Gazer Learning Buddy speech.
# Teacher Hub's "Add with AI" also uses it, to read pasted text, photos, screenshots and files.
# Without it, a pasted list still becomes to-dos and calendar files and links still work.
# Never expose this with a VITE_ prefix.
OPENAI_API_KEY=your-openai-api-key

# Online payment for Premium plans (Stripe, server only)
# Payment stays closed until STRIPE_SECRET_KEY is set. Both values can also be
# saved in Admin > Plans and billing. Never expose these with a VITE_ prefix.
# STRIPE_SECRET_KEY=sk_live_...
# The signing secret of the webhook endpoint https://<your site>/api/billing/webhook
# STRIPE_WEBHOOK_SECRET=whsec_...
